# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === NextAuth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === OpenAI (optional — mock responses used when unset) ===
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# === Creem Payment ===
# Get these from https://dashboard.creem.io
CREEM_API_KEY=creem_...
# Product IDs created in the Creem dashboard for the monthly / yearly subscription
CREEM_PRODUCT_ID_MONTHLY=prod_...
CREEM_PRODUCT_ID_YEARLY=prod_...
# Created when you add a webhook endpoint in Creem
# (URL: <SITE_URL>/api/payment/callback)
# Listen for: checkout.completed, subscription.active, subscription.paid
CREEM_WEBHOOK_SECRET=whsec_...

# === Resend (Email for password reset) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# === Database (Turso) ===
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
