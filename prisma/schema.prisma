generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          String    @default("free")
  planExpiresAt DateTime?
  // Creem customer id captured from the first successful subscription
  // webhook. Used to mint the hosted customer-portal link where users can
  // cancel / manage / update payment method.
  creemCustomerId String?
  resumeExports      Int @default(0)
  coverLetterExports Int @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  resumes      Resume[]
  coverLetters CoverLetter[]
}

/// Tracks export quota for non-authenticated visitors.
/// Identified by an HMAC-signed `guest_id` HTTP-only cookie.
/// `ipHash` and `uaHash` are additional anti-abuse signals (no raw PII stored).
model GuestSession {
  id                  String    @id @default(cuid())
  cookieId            String    @unique
  ipHash              String
  uaHash              String
  resumeExports       Int       @default(0)
  coverLetterExports  Int       @default(0)
  migratedToUserId    String?
  createdAt           DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())

  @@index([ipHash])
  @@index([migratedToUserId])
}

/// Append-only audit + rate-limit source. Every consume call writes a row,
/// whether it succeeded or not — so refresh / cookie-clearing abuse is visible
/// to the rate limiter even when the cap would otherwise hide it.
///
/// `actorType` is "user" or "guest"; `actorId` is the User.id or GuestSession.cookieId.
/// `outcome` is one of: "consumed" | "rate_limited" | "cap_reached" | "template_locked".
model UsageEvent {
  id          String   @id @default(cuid())
  actorType   String
  actorId     String
  kind        String
  outcome     String   @default("consumed")
  delta       Int      @default(1)
  ipHash      String
  uaHash      String
  token       String?
  refundedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([ipHash, createdAt])
  @@index([token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@index([email])
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("Untitled Resume")
  data       String
  template   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoverLetter {
  id         String   @id @default(cuid())
  userId     String
  title      String   @default("Untitled Cover Letter")
  data       String
  templateId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
