# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === NextAuth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secret_here

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === OpenAI (optional — mock responses used when unset) ===
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# === Stripe Payment ===
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_or_sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_test_or_pk_live_...
# Created when you add a webhook endpoint at
# https://dashboard.stripe.com/webhooks (URL: <SITE_URL>/api/payment/callback)
# Listen for: checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...

# === Resend (Email for password reset) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# === Database (Turso) ===
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=
